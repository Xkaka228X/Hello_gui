local function AddVisuals(player)
    if DrawingStore[player] then return end
    DrawingStore[player] = {Line = Drawing.new("Line"), Box = Drawing.new("Square")}
    DrawingStore[player].Line.Thickness = 1.5
    DrawingStore[player].Box.Thickness = 1.5
    DrawingStore[player].Box.Filled = false
end

-- [[ 4. МАТЕМАТИКА ]]
local function GetScreenPos(pos)
    local screen, vis = Camera:WorldToViewportPoint(pos)
    if vis then return Vector2.new(screen.X, screen.Y), true end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local rel = (Vector2.new(screen.X, screen.Y) - center)
    if rel.Magnitude == 0 then return center, false end
    local k = math.min((center.X - 20) / math.abs(rel.X), (center.Y - 20) / math.abs(rel.Y))
    return (screen.Z < 0) and (center - (rel * k)) or (center + (rel * k)), false
end

local function GetClosestTarget()
    local target, minMag = nil, Config.FOV
    local mouse = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChild("Humanoid")
            local part = p.Character:FindFirstChild(Config.Part)
            if hum and part and hum.Health > 0 then
                local screen, vis = Camera:WorldToViewportPoint(part.Position)
                if vis then
                    local mag = (Vector2.new(screen.X, screen.Y) - mouse).Magnitude
                    if mag < minMag then minMag = mag; target = part end
                end
            end
        end
    end
    return target
end

-- [[ 5. ЦИКЛ ]]
local Connection
Connection = RunService.RenderStepped:Connect(function()
    if not Config.Running then 
        Connection:Disconnect()
        return 
    end

    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOV_Circle.Position = center
    FOV_Circle.Radius = Config.FOV
    FOV_Circle.Visible = Config.Aim

    if Config.Aim then
        local t = GetClosestTarget()
        if t then Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, t.Position), Config.Speed) end
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                AddVisuals(p)
                local v = DrawingStore[p]
                local root = p.Character.HumanoidRootPart
                local screenPos, onScreen = GetScreenPos(root.Position)
                local dist = (Camera.CFrame.Position - root.Position).Magnitude
                local col = Color3.fromHSV(math.clamp(dist / Config.MaxDist, 0, 0.33), 1, 1)

                v.Line.From = center; v.Line.To = screenPos; v.Line.Color = col; v.Line.Visible = Config.Tracers
                if Config.ESP and onScreen then
                    local s = math.clamp(2500 / dist, 5, 300)
                    v.Box.Size = Vector2.new(s, s * 1.5); v.Box.Position = Vector2.new(screenPos.X - s / 2, screenPos.Y - s * 0.75)
                    v.Box.Color = col; v.Box.Visible = true
                else v.Box.Visible = false end
            elseif DrawingStore[p] then
                DrawingStore[p].Line.Visible = false; DrawingStore[p].Box.Visible = false
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if DrawingStore[p] then
        DrawingStore[p].Line:Remove()
        DrawingStore[p].Box:Remove()
        DrawingStore[p] = nil
    end
end)

