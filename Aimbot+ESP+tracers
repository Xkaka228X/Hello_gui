_G.unload_esp = function()
    state.active = false
    for _, item in pairs(cache) do
        if item.line then item.line:Remove() end
        if item.box then item.box:Remove() end
    end
    table.clear(cache)
    if fov_ring then fov_ring:Remove() end
end

