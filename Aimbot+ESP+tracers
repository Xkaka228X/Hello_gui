end)

local function make_toggle(name, offset, key)
    local btn = Instance.new("TextButton", main)
    btn.Size = UDim2.new(0.9, 0, 0, 30)
    btn.Position = UDim2.new(0.05, 0, 0, offset)
    btn.BackgroundColor3 = state[key] and Color3.fromRGB(30, 30, 30) or Color3.fromRGB(20, 20, 20)
    btn.Text = name .. (state[key] and ": ON" or ": OFF")
    btn.TextColor3 = state[key] and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    btn.Font = Enum.Font.Code
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.fromRGB(60, 60, 60)

    btn.MouseButton1Click:Connect(function()
        state[key] = not state[key]
        btn.Text = name .. (state[key] and ": ON" or ": OFF")
        btn.TextColor3 = state[key] and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    end)
end

