local function init_draw(p)
    if cache[p] then return end
    cache[p] = {line = Drawing.new("Line"), box = Drawing.new("Square")}
    cache[p].line.Thickness = 1.5
    cache[p].box.Thickness = 1.5
    cache[p].box.Filled = false
end

local function get_screen_data(pos)
    local screen, visible = cam:WorldToViewportPoint(pos)
    if visible then return Vector2.new(screen.X, screen.Y), true end
    local mid = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local diff = (Vector2.new(screen.X, screen.Y) - mid)
    if diff.Magnitude == 0 then return mid, false end
    local scale = math.min((mid.X - 20) / math.abs(diff.X), (mid.Y - 20) / math.abs(diff.Y))
    return (screen.Z < 0) and (mid - (diff * scale)) or (mid + (diff * scale)), false
end

local function find_best_target()
    local target, near = nil, state.fov
    local mid = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    for _, p in pairs(plrs:GetPlayers()) do
        if p ~= l_plr and p.Character then
            local root = p.Character:FindFirstChild("Humanoid")
            local hit = p.Character:FindFirstChild(state.part)
            if root and hit and root.Health > 0 then
                local screen, visible = cam:WorldToViewportPoint(hit.Position)
                if visible then
                    local dist = (Vector2.new(screen.X, screen.Y) - mid).Magnitude
                    if dist < near then near = dist; target = hit end
                end
            end
        end
    end
    return target
end

local loop
loop = r_service.RenderStepped:Connect(function()
    if not state.active then 
        loop:Disconnect()
        return 
    end

    local mid = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    fov_ring.Position = mid
    fov_ring.Radius = state.fov
    fov_ring.Visible = state.aim

    if state.aim then
        local lock = find_best_target()
        if lock then cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, lock.Position), state.speed) end
    end

    for _, p in pairs(plrs:GetPlayers()) do
        if p ~= l_plr then
            local char = p.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                init_draw(p)
                local data = cache[p]
                local root = char.HumanoidRootPart
                local s_pos, is_on_screen = get_screen_data(root.Position)
                local distance = (cam.CFrame.Position - root.Position).Magnitude
                local color = Color3.fromHSV(math.clamp(distance / state.max_dist, 0, 0.33), 1, 1)

                data.line.From = mid; data.line.To = s_pos; data.line.Color = color; data.line.Visible = state.tracers
                if state.esp and is_on_screen then
                    local size = math.clamp(2500 / distance, 5, 300)
                    data.box.Size = Vector2.new(size, size * 1.5)
                    data.box.Position = Vector2.new(s_pos.X - size / 2, s_pos.Y - size * 0.75)
                    data.box.Color = color
                    data.box.Visible = true
                else data.box.Visible = false end
            elseif cache[p] then
                cache[p].line.Visible = false; cache[p].box.Visible = false
            end
        end
    end
end)

plrs.PlayerRemoving:Connect(function(p)
    if cache[p] then
        cache[p].line:Remove()
        cache[p].box:Remove()
        cache[p] = nil
    end
end)
