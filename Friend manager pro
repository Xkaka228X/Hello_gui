-- ЛОГИКА
local function updateList()
    for _, v in pairs(Scroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
    
    -- Друзья из Roblox
    pcall(function()
        local friends = Players:GetFriendsAsync(LocalPlayer.UserId)
        while true do
            for _, item in ipairs(friends:GetCurrentPage()) do
                local Entry = Instance.new("Frame")
                Entry.Size = UDim2.new(1, 0, 0, 50)
                Entry.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
                Entry.Parent = Scroll
                Instance.new("UICorner", Entry)

                local Img = Instance.new("ImageLabel")
                Img.Size = UDim2.new(0, 40, 0, 40)
                Img.Position = UDim2.new(0, 5, 0.5, -20)
                Img.Image = "rbxthumb://type=AvatarHeadShot&id="..item.Id.."&w=150&h=150"
                Img.Parent = Entry
                Instance.new("UICorner", Img).CornerRadius = UDim.new(1,0)

                local Dot = Instance.new("Frame")
                Dot.Size = UDim2.new(0, 10, 0, 10)
                Dot.Position = UDim2.new(0, 35, 0, 35)
                Dot.BackgroundColor3 = Players:FindFirstChild(item.Username) and Color3.new(0, 1, 0) or Color3.new(0.6, 0.6, 0.6)
                Dot.Parent = Entry
                Instance.new("UICorner", Dot).CornerRadius = UDim.new(1,0)

                local Txt = Instance.new("TextLabel")
                Txt.Size = UDim2.new(1, -60, 1, 0); Txt.Position = UDim2.new(0, 55, 0, 0)
                Txt.Text = "⭐ " .. item.Username; Txt.TextColor3 = Color3.new(1, 0.8, 0); Txt.BackgroundTransparency = 1; Txt.TextXAlignment = 0; Txt.Parent = Entry
            end
            if friends.IsFinished then break end
            friends:AdvanceToNextPageAsync()
        end
    end)

    -- Сохраненные вручную
    if isfile(FILE_NAME) then
        for line in readfile(FILE_NAME):gmatch("[^\r\n]+") do
            local name, id = line:match("([^:]+):(%d+)")
            if name then
                local Entry = Instance.new("Frame")
                Entry.Size = UDim2.new(1, 0, 0, 50)
                Entry.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
                Entry.Parent = Scroll
                Instance.new("UICorner", Entry)

                local Img = Instance.new("ImageLabel")
                Img.Size = UDim2.new(0, 40, 0, 40); Img.Position = UDim2.new(0, 5, 0.5, -20)
                Img.Image = "rbxthumb://type=AvatarHeadShot&id="..(id or 0).."&w=150&h=150"; Img.Parent = Entry
                Instance.new("UICorner", Img).CornerRadius = UDim.new(1,0)

                local Dot = Instance.new("Frame")
                Dot.Size = UDim2.new(0, 10, 0, 10); Dot.Position = UDim2.new(0, 35, 0, 35)
                Dot.BackgroundColor3 = Players:FindFirstChild(name) and Color3.new(0, 1, 0) or Color3.new(0.6, 0.6, 0.6)
                Dot.Parent = Entry; Instance.new("UICorner", Dot).CornerRadius = UDim.new(1,0)

                local Txt = Instance.new("TextLabel")
                Txt.Size = UDim2.new(1, -100, 1, 0); Txt.Position = UDim2.new(0, 55, 0, 0)
                Txt.Text = name; Txt.TextColor3 = Color3.new(1,1,1); Txt.BackgroundTransparency = 1; Txt.TextXAlignment = 0; Txt.Parent = Entry
                
                local Del = Instance.new("TextButton")
                Del.Size = UDim2.new(0, 30, 0, 30); Del.Position = UDim2.new(1, -35, 0.5, -15); Del.Text = "✕"; Del.BackgroundColor3 = Color3.new(0.7, 0, 0); Del.TextColor3 = Color3.new(1,1,1); Del.Parent = Entry
                Instance.new("UICorner", Del)
                Del.MouseButton1Click:Connect(function()
                    Entry:Destroy()
                    -- Логика удаления из файла...
                end)
            end
        end
    end
end

local selectedPlayer = nil
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local target = LocalPlayer:GetMouse().Target
        if target and target.Parent:FindFirstChild("Humanoid") then
            local p = Players:GetPlayerFromCharacter(target.Parent)
            if p and p ~= LocalPlayer then
                selectedPlayer = p
                PlayerTitle.Text = p.Name
                InteractionMenu.Position = UDim2.new(0, input.Position.X, 0, input.Position.Y - 50)
                InteractionMenu.Visible = true
            end
        end
    end
end)

SaveBtn.MouseButton1Click:Connect(function()
    if selectedPlayer then
        local data = selectedPlayer.Name .. ":" .. selectedPlayer.UserId
        local current = isfile(FILE_NAME) and readfile(FILE_NAME) or ""
        if not current:find(selectedPlayer.Name) then
            writefile(FILE_NAME, (current == "" and data or current .. "\n" .. data))
        end
        InteractionMenu.Visible = false
    end
end)

CloseBtn.MouseButton1Click:Connect(function() InteractionMenu.Visible = false end)
OpenListBtn.MouseButton1Click:Connect(function() FriendsListFrame.Visible = not FriendsListFrame.Visible if FriendsListFrame.Visible then updateList() end end)
