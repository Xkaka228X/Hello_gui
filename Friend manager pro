            pBtn.MouseButton1Click:Connect(function()
                SelectorFrame.Visible = false; selectedPlayer = p; PlayerTitle.Text = p.Name; NoteInput.Text = ""; InteractionMenu.Position = UDim2.new(0.5, -100, 0.5, -90); InteractionMenu.Visible = true
            end)
        end
    end
end)

SelectorBack.MouseButton1Click:Connect(function() SelectorFrame.Visible = false end)
LangBtn.MouseButton1Click:Connect(function() currentLanguage = (currentLanguage == "RU") and "EN" or "RU"; refreshUI() end)
ToggleClickBtn.MouseButton1Click:Connect(function() clickSystemEnabled = not clickSystemEnabled; refreshUI() end)

SaveBtn.MouseButton1Click:Connect(function()
    if selectedPlayer then
        local note = NoteInput.Text:gsub(":", "")
        local data = selectedPlayer.Name .. ":" .. selectedPlayer.UserId .. ":" .. note
        local current = isfile(FILE_NAME) and readfile(FILE_NAME) or ""
        local lines = {}
        local found = false
        for line in current:gmatch("[^\r\n]+") do
            if line:find("^" .. selectedPlayer.Name .. ":") then table.insert(lines, data); found = true else table.insert(lines, line) end
        end
        if not found then table.insert(lines, data) end
        writefile(FILE_NAME, table.concat(lines, "\n"))
        InteractionMenu.Visible = false; updateList()
    end
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed or not clickSystemEnabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local target = LocalPlayer:GetMouse().Target
        if target and target.Parent:FindFirstChild("Humanoid") then
            local p = Players:GetPlayerFromCharacter(target.Parent)
            if p and p ~= LocalPlayer then selectedPlayer = p; PlayerTitle.Text = p.Name; NoteInput.Text = ""; InteractionMenu.Position = UDim2.new(0, input.Position.X, 0, input.Position.Y - 50); InteractionMenu.Visible = true end
        end
    end
end)

CloseBtn.MouseButton1Click:Connect(function() InteractionMenu.Visible = false end)
OpenListBtn.MouseButton1Click:Connect(function() FriendsListFrame.Visible = not FriendsListFrame.Visible if FriendsListFrame.Visible then updateList() end end)

refreshUI()
