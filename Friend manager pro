    ListHeader.Text = t.title; ToggleClickBtn.Text = clickSystemEnabled and t.clickOn or t.clickOff
    ToggleClickBtn.BackgroundColor3 = clickSystemEnabled and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)
