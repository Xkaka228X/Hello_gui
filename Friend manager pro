local function updateList()
    for _, v in pairs(Scroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
    
    -- 1. ДРУЗЬЯ ROBLOX
    task.spawn(function()
        pcall(function()
            local friends = Players:GetFriendsAsync(LocalPlayer.UserId)
            for _, item in ipairs(friends:GetCurrentPage()) do
                local Entry = Instance.new("Frame")
                Entry.Size = UDim2.new(1, 0, 0, 50); Entry.BackgroundColor3 = Color3.fromRGB(45, 45, 45); Entry.Parent = Scroll; Instance.new("UICorner", Entry)
                
                local Img = Instance.new("ImageLabel")
                Img.Size = UDim2.new(0, 40, 0, 40); Img.Position = UDim2.new(0, 5, 0.5, -20); Img.Image = "rbxthumb://type=AvatarHeadShot&id="..item.Id.."&w=150&h=150"; Img.Parent = Entry; Instance.new("UICorner", Img).CornerRadius = UDim.new(1,0)
                
                -- Индикатор статуса (онлайн на сервере)
                local Status = Instance.new("Frame")
                Status.Size = UDim2.new(0, 10, 0, 10); Status.Position = UDim2.new(0, 35, 0, 35)
                Status.BackgroundColor3 = Players:FindFirstChild(item.Username) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(100, 100, 100)
                Status.ZIndex = 5; Status.Parent = Entry; Instance.new("UICorner", Status).CornerRadius = UDim.new(1,0)
                
                local Txt = Instance.new("TextLabel")
                Txt.Size = UDim2.new(1, -60, 1, 0); Txt.Position = UDim2.new(0, 55, 0, 0); Txt.Text = "⭐ " .. item.Username; Txt.TextColor3 = Color3.new(1, 0.8, 0); Txt.BackgroundTransparency = 1; Txt.TextXAlignment = 0; Txt.Font = Enum.Font.GothamBold; Txt.Parent = Entry
            end
        end)
    end)

    -- 2. ЛОКАЛЬНЫЕ ДРУЗЬЯ (из файла)
    if isfile(FILE_NAME) then
        for line in readfile(FILE_NAME):gmatch("[^\r\n]+") do
            local name, id, note = line:match("([^:]+):([^:]+):?(.*)")
            if name and id then
                local Entry = Instance.new("Frame")
                Entry.Size = UDim2.new(1, 0, 0, 55); Entry.BackgroundColor3 = Color3.fromRGB(55, 55, 55); Entry.Parent = Scroll; Instance.new("UICorner", Entry)
                
                local Img = Instance.new("ImageLabel")
                Img.Size = UDim2.new(0, 40, 0, 40); Img.Position = UDim2.new(0, 5, 0.5, -20); Img.Image = "rbxthumb://type=AvatarHeadShot&id="..id.."&w=150&h=150"; Img.Parent = Entry; Instance.new("UICorner", Img).CornerRadius = UDim.new(1,0)
                
                -- Индикатор статуса
                local Status = Instance.new("Frame")
                Status.Size = UDim2.new(0, 10, 0, 10); Status.Position = UDim2.new(0, 35, 0, 35)
                Status.BackgroundColor3 = Players:FindFirstChild(name) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(100, 100, 100)
                Status.ZIndex = 5; Status.Parent = Entry; Instance.new("UICorner", Status).CornerRadius = UDim.new(1,0)

                local NameTxt = Instance.new("TextLabel")
                NameTxt.Size = UDim2.new(1, -140, 0, 20); NameTxt.Position = UDim2.new(0, 55, 0, 10); NameTxt.Text = name; NameTxt.TextColor3 = Color3.new(1,1,1); NameTxt.Font = Enum.Font.GothamBold; NameTxt.BackgroundTransparency = 1; NameTxt.TextXAlignment = 0; NameTxt.Parent = Entry
                
                local NoteTxt = Instance.new("TextLabel")
                NoteTxt.Size = UDim2.new(1, -140, 0, 15); NoteTxt.Position = UDim2.new(0, 55, 0, 30); NoteTxt.Text = (note ~= "" and note or "..."); NoteTxt.TextColor3 = Color3.fromRGB(180, 180, 180); NoteTxt.TextSize = 12; NoteTxt.Font = Enum.Font.Gotham; NoteTxt.BackgroundTransparency = 1; NoteTxt.TextXAlignment = 0; NoteTxt.Parent = Entry

                local Del = Instance.new("TextButton")
                Del.Size = UDim2.new(0, 70, 0, 30); Del.Position = UDim2.new(1, -75, 0.5, -15); Del.BackgroundColor3 = Color3.fromRGB(150, 0, 0); Del.Text = getTxt("delete"); Del.TextColor3 = Color3.new(1,1,1); Del.Parent = Entry; Instance.new("UICorner", Del)
                Del.MouseButton1Click:Connect(function()
                    local lines = {}
                    for l in readfile(FILE_NAME):gmatch("[^\r\n]+") do if l ~= line then table.insert(lines, l) end end
                    writefile(FILE_NAME, table.concat(lines, "\n")); Entry:Destroy(); task.wait(0.1); resizeMenu()
                end)
            end
        end
    end
end

