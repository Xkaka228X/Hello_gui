local currentLanguage = "RU"

-- --- ГЕНЕРАЦИЯ СПИСКА ---
local function PopulateList(filter)
    for _, child in pairs(CommandList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local count = 0
    for _, item in pairs(IY_Data) do
        local filterLower = filter:lower()
        if filter == ""
            or string.find(item.cmd:lower(), filterLower)
            or string.find(item.descRU:lower(), filterLower)
            or string.find(item.descEN:lower(), filterLower)
        then
            count = count + 1
            local Card = Instance.new("Frame")
            Card.Size = UDim2.new(1, 0, 0, 70)
            Card.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            Card.Parent = CommandList
            
            local UIC = Instance.new("UICorner")
            UIC.CornerRadius = UDim.new(0, 10)
            UIC.Parent = Card

            local CmdTxt = Instance.new("TextLabel")
            CmdTxt.Size = UDim2.new(1, -20, 0, 30)
            CmdTxt.Position = UDim2.new(0, 10, 0, 5)
            CmdTxt.Text = item.cmd
            CmdTxt.TextColor3 = Color3.fromRGB(0, 200, 255)
            CmdTxt.Font = Enum.Font.GothamBold
            CmdTxt.TextXAlignment = Enum.TextXAlignment.Left
            CmdTxt.BackgroundTransparency = 1
            CmdTxt.Parent = Card

            local DescTxt = Instance.new("TextLabel")
            DescTxt.Size = UDim2.new(1, -20, 0, 30)
            DescTxt.Position = UDim2.new(0, 10, 0, 35)
            DescTxt.Text = (currentLanguage == "RU") and item.descRU or item.descEN
            DescTxt.TextColor3 = Color3.fromRGB(200, 200, 200)
            DescTxt.TextSize = 13
            DescTxt.TextWrapped = true
            DescTxt.TextXAlignment = Enum.TextXAlignment.Left
            DescTxt.BackgroundTransparency = 1
            DescTxt.Parent = Card
        end
    end

    -- Динамическое обновление размера канваса
    CommandList.CanvasSize = UDim2.new(0, 0, 0, count * 76)
end

-- --- ЛОГИКА КНОПОК И ПОИСКА ---
LangButton.MouseButton1Click:Connect(function()
    if currentLanguage == "RU" then
        currentLanguage = "EN"
        LangButton.Text = "EN"
        SearchBar.PlaceholderText = "Search for any command..."
    else
        currentLanguage = "RU"
        LangButton.Text = "RU"
        SearchBar.PlaceholderText = "Найти любую команду..."
    end
    PopulateList(SearchBar.Text)
end)

SearchBar.Changed:Connect(function()
    PopulateList(SearchBar.Text)
end)

