-- ═══ ЛОГИКА ═══
local function T(key)
    return translations[lang][key] or key
end

local function updateWeather(cityName)
    if not cityName then return end
    isLoading = true
    currentTemp = T("loading") .. "..."
    currentCity = cityName
    currentWeatherCode = nil
    lastSelectedCity = cityName
    lastUpdateTime = tick()

    task.spawn(function()
        local ok, err = pcall(function()
            local geoUrl = "https://geocoding-api.open-meteo.com/v1/search?name="
                .. HttpService:UrlEncode(cityName) .. "&count=1&format=json"
            local geoData = HttpService:JSONDecode(httpGet(geoUrl))
            if not geoData.results or #geoData.results == 0 then error("City not found") end
            local res = geoData.results[1]
            local wUrl = string.format(
                "https://api.open-meteo.com/v1/forecast?latitude=%f&longitude=%f&current_weather=true",
                res.latitude, res.longitude
            )
            local wData = HttpService:JSONDecode(httpGet(wUrl))
            local cw = wData.current_weather
            currentCity = res.name
            currentTemp = string.format("%+.1f°C", cw.temperature)
            currentWeatherCode = cw.weathercode
        end)
        if not ok then currentTemp = "Error" end
        isLoading = false
    end)
end

local function clearMenu()
    for _, c in pairs(menu:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
end

local function makeBtn(text, bg, textColor)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, 24)
    btn.BackgroundColor3 = bg
    btn.TextColor3 = textColor or Color3.fromRGB(220, 220, 220)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.BorderSizePixel = 0
    btn.Parent = menu
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {
            BackgroundColor3 = Color3.new(
                math.min(bg.R + 0.12, 1),
                math.min(bg.G + 0.12, 1),
                math.min(bg.B + 0.12, 1)
            )
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), { BackgroundColor3 = bg }):Play()
    end)
    return btn
end

local showCountries, showCities

showCountries = function()
    clearMenu()
    local sorted = {}
    for k in pairs(locations) do table.insert(sorted, k) end
    table.sort(sorted)
    for _, country in ipairs(sorted) do
        local btn = makeBtn("  " .. country, Color3.fromRGB(25, 25, 42))
        btn.MouseButton1Click:Connect(function() showCities(country) end)
    end
    menu.CanvasSize = UDim2.new(0, 0, 0, #menu:GetChildren() * 27)
end

showCities = function(country)
    clearMenu()
    local back = makeBtn("  " .. T("back"), Color3.fromRGB(70, 15, 15), Color3.fromRGB(255, 110, 110))
    back.MouseButton1Click:Connect(showCountries)
    for _, city in ipairs(locations[country]) do
        local btn = makeBtn("    • " .. city, Color3.fromRGB(12, 40, 18), Color3.fromRGB(140, 255, 140))
        btn.MouseButton1Click:Connect(function() updateWeather(city) end)
    end
    menu.CanvasSize = UDim2.new(0, 0, 0, #menu:GetChildren() * 27)
end

-- ═══ SHOW/HIDE ═══
local function toggleVisibility()
    isVisible = not isVisible
    eyeLabel.Text = isVisible and "👁️" or "🙈"
    toggleStroke.Color = isVisible and Color3.fromRGB(0, 200, 255) or Color3.fromRGB(255, 80, 80)
    TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = isVisible and UDim2.new(0, 310, 0, 240) or UDim2.new(0, 310, 0, 32)
    }):Play()
end

toggleBtn.MouseButton1Click:Connect(toggleVisibility)

-- ═══ ЯЗЫК ═══
langBtn.MouseButton1Click:Connect(function()
    lang = lang == "EN" and "RU" or "EN"
    langBtn.Text = "🌐" .. lang
    titleLabel.Text = "⚡ " .. T("title")
    showCountries()
end)

-- ═══ ПУЛЬС ═══
task.spawn(function()
    while true do
        TweenService:Create(pulseDot, TweenInfo.new(0.7), {
            BackgroundTransparency = 0.85,
            Size = UDim2.new(0, 5, 0, 5),
            Position = UDim2.new(1, -7, 0, 2)
        }):Play()
        task.wait(0.7)
        TweenService:Create(pulseDot, TweenInfo.new(0.7), {
            BackgroundTransparency = 0,
            Size = UDim2.new(0, 7, 0, 7),
            Position = UDim2.new(1, -8, 0, 1)
        }):Play()
        task.wait(0.7)
    end
end)
-- ═══ DRAG (перетаскивание) ═══
local dragging = false
local dragStart = nil
local startPos = nil

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)

topBar.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement 
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

topBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- ═══ СТАРТ ═══
showCountries()


-- ═══ ГЛАВНЫЙ ЦИКЛ ═══
RunService.RenderStepped:Connect(function()
    local now = os.date("*t")
    local t = translations[lang]

    if lastSelectedCity and not isLoading then
        local elapsed = tick() - lastUpdateTime
        local remaining = math.max(0, autoUpdateInterval - elapsed)
        autoLabel.Text = string.format(
            "<font color='#FFA500'>%s:</font> <font color='#888888'>%d:%02d</font>",
            t.auto, math.floor(remaining / 60), remaining % 60
        )
        if elapsed >= autoUpdateInterval then
            updateWeather(lastSelectedCity)
        end
    else
        autoLabel.Text = ""
    end

    local dots = isLoading and string.rep(".", math.floor(tick() * 2) % 4) or ""
    local icon = currentWeatherCode and (weatherIcons[currentWeatherCode] or "🌡️") or "🌡️"
    local condText = ""
    if currentWeatherCode ~= nil then
        local desc = (weatherDescriptions[lang] or weatherDescriptions["EN"])[currentWeatherCode]
        condText = string.format(
            "\n<font color='#88CCFF'>%s:</font> %s %s",
            t.cond, icon, desc or ("Code "..currentWeatherCode)
        )
    end

    display.Text = string.format(
        "<b><font color='#FFA500'>[ %s ]</font></b>\n"
        .."<font color='#888'>%s:</font> <b>%02d:%02d:%02d</b>  "
        .."<font color='#888'>%s:</font> <b>%02d.%02d.%04d</b>\n"
        .."<font color='#FFA500'>%s:</font> %s\n"
        .."<font color='#FFA500'>%s:</font> %s%s"
        .."%s",
        t.title,
        t.time, now.hour, now.min, now.sec,
        t.date, now.day, now.month, now.year,
        t.city, currentCity,
        t.temp, currentTemp, dots,
        condText
    )
end)
