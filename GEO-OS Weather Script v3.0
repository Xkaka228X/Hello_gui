-- ═══ HTTP для Delta Mobile ═══
local function httpGet(url)
    local ok, res = pcall(function()
        return http_request({ Url = url, Method = "GET" })
    end)
    if ok and res and res.Body and res.Body ~= "" then return res.Body end

    local ok2, res2 = pcall(function()
        return request({ Url = url, Method = "GET" })
    end)
    if ok2 and res2 and res2.Body and res2.Body ~= "" then return res2.Body end

    local ok3, res3 = pcall(function()
        return http.request({ Url = url, Method = "GET" })
    end)
    if ok3 and res3 and res3.Body and res3.Body ~= "" then return res3.Body end

    error("HTTP failed")
end

