-- [ ENGINE ] --
local function encode(data)
    local res = ""
    for i = 1, #data do
        local b = data:sub(i, i):byte()
        local high = math.floor(b / 16) + 1
        local low = (b % 16) + 1
        res = res .. CFG.SYLLABLES[high] .. CFG.SYLLABLES[low]
    end
    return res
end

local function decode(data)
    local res = {}
    local lookup = {}
    for i, v in ipairs(CFG.SYLLABLES) do lookup[v] = i - 1 end
    for i = 1, #data, 4 do
        local s1, s2 = data:sub(i, i+1), data:sub(i+2, i+3)
        local h, l = lookup[s1], lookup[s2]
        if h and l then table.insert(res, string.char(h * 16 + l)) end
    end
    return table.concat(res)
end

local function crypt(text, key, mode)
    local out = {}
    for i = 1, #text do
        local b = text:sub(i, i):byte()
        local k = key:sub((i - 1) % #key + 1, (i - 1) % #key + 1):byte()
        table.insert(out, string.char(bit32.bxor(b, k)))
    end
    
    local roleFlag = "0"
    if LocalPlayer.UserId == CFG.OWNER_ID then roleFlag = "1"
    elseif LocalPlayer.UserId == CFG.TESTER_ID then roleFlag = "2"
    elseif LocalPlayer.UserId == CFG.W_ID then roleFlag = "3" end
    
    return mode .. roleFlag .. encode(table.concat(out))
end

local function decrypt(raw, key)
    local mode = raw:sub(1, 1)
    local role = raw:sub(2, 2)
    local decoded = decode(raw:sub(3))
    local out = {}
    for i = 1, #decoded do
        local b = decoded:sub(i, i):byte()
        local k = key:sub((i - 1) % #key + 1, (i - 1) % #key + 1):byte()
        table.insert(out, string.char(bit32.bxor(b, k)))
    end
    return mode, table.concat(out), role
end

