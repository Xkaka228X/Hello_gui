local function updateView()
    for _, v in pairs(ChatArea:GetChildren()) do if v:IsA("TextLabel") then v:Destroy() end end
    ChatTitle.Text = "GHOST-WIRE HW | " .. CurrentChat
    
    local data = Contacts[CurrentChat]
    if not data then return end
    
    data.unread = 0
    local btn = SideBar:FindFirstChild(CurrentChat)
    if btn then 
        local prefix = ""
        if Badges[btn.Name] == "1" then prefix = "⭐ "
        elseif Badges[btn.Name] == "2" then prefix = "🛠 "
        elseif Badges[btn.Name] == "3" then prefix = "W🔥 " end
        btn.Text = prefix .. btn.Name
        btn.BackgroundColor3 = (CurrentChat == btn.Name) and Color3.fromRGB(80, 80, 100) or Color3.fromRGB(50,50,50)
    end

    for _, msg in pairs(data.messages) do
        local lbl = Instance.new("TextLabel", ChatArea)
        lbl.Size = UDim2.new(1, -10, 0, 0)
        lbl.AutomaticSize = Enum.AutomaticSize.Y
        lbl.BackgroundTransparency = 1
        
        if msg.role == "1" then 
            lbl.TextColor3 = Color3.fromRGB(255, 215, 0) 
            lbl.Text = " [⭐ AUTHOR " .. msg.sender .. "]: " .. msg.text
            lbl.Font = Enum.Font.SourceSansBold
        elseif msg.role == "2" then 
            lbl.TextColor3 = Color3.fromRGB(0, 255, 255) 
            lbl.Text = " [🛠 TESTER " .. msg.sender .. "]: " .. msg.text
            lbl.Font = Enum.Font.SourceSansBold
        elseif msg.role == "3" then 
            lbl.TextColor3 = Color3.fromRGB(255, 100, 0) 
            lbl.Text = " [W🔥 " .. msg.sender .. "]: " .. msg.text
            lbl.Font = Enum.Font.SourceSansBold
        else
            lbl.TextColor3 = msg.mine and Color3.fromRGB(0, 170, 255) or Color3.new(1,1,1)
            lbl.Text = " [" .. msg.sender .. "]: " .. msg.text
            lbl.Font = Enum.Font.SourceSans
        end
        
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextWrapped = true
        lbl.TextSize = 16
    end
    ChatArea.CanvasSize = UDim2.new(0, 0, 0, UIListChat.AbsoluteContentSize.Y + 10)
    ChatArea.CanvasPosition = Vector2.new(0, math.max(0, UIListChat.AbsoluteContentSize.Y - ChatArea.AbsoluteWindowSize.Y))
end

local function addContact(name, role)
    if role ~= "0" then Badges[name] = role end
    if SideBar:FindFirstChild(name) then return end
    if not Contacts[name] then Contacts[name] = {messages = {}, unread = 0} end
    
    local btn = Instance.new("TextButton", SideBar)
    btn.Name = name
    btn.Size = UDim2.new(1, -5, 0, 30)
    btn.BackgroundColor3 = (CurrentChat == name) and Color3.fromRGB(80, 80, 100) or Color3.fromRGB(50,50,50)
    
    local prefix = ""
    if role == "1" then prefix = "⭐ " btn.TextColor3 = Color3.fromRGB(255, 215, 0)
    elseif role == "2" then prefix = "🛠 " btn.TextColor3 = Color3.fromRGB(0, 255, 255)
    elseif role == "3" then prefix = "W🔥 " btn.TextColor3 = Color3.fromRGB(255, 100, 0)
    else btn.TextColor3 = Color3.new(1,1,1) end
    
    btn.Text = prefix .. name
    Instance.new("UICorner", btn)
    
    btn.MouseButton1Click:Connect(function() 
        CurrentChat = name 
        updateView() 
        for _, v in pairs(SideBar:GetChildren()) do
            if v:IsA("TextButton") then 
                v.BackgroundColor3 = (v.Name == name) and Color3.fromRGB(80, 80, 100) or Color3.fromRGB(50,50,50)
            end
        end
    end)
end

addContact("Global", "0")

local function notifyContact(name)
    if CurrentChat == name then return end
    local data = Contacts[name]
    if data then
        data.unread = data.unread + 1
        local btn = SideBar:FindFirstChild(name)
        if btn then
            local prefix = ""
            if Badges[name] == "1" then prefix = "⭐ "
            elseif Badges[name] == "2" then prefix = "🛠 "
            elseif Badges[name] == "3" then prefix = "W🔥 " end
            btn.Text = prefix .. name .. " [" .. data.unread .. "]"
            btn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
        end
        playNotify()
    end
end

local function send(text, mode)
    local endp = ReplicatedStorage:FindFirstChild("SayMessageRequest", true) or 
                 (TextChatService.ChatVersion == Enum.ChatVersion.TextChatService and TextChatService.TextChannels.RBXGeneral)
    if not endp then return end

    local payload = ""
    local myRole = "0"
    if LocalPlayer.UserId == CFG.OWNER_ID then myRole = "1"
    elseif LocalPlayer.UserId == CFG.TESTER_ID then myRole = "2"
    elseif LocalPlayer.UserId == CFG.W_ID then myRole = "3" end

    if mode == "SYNC" then
        payload = CFG.TAG .. CFG.S_MARK .. myRole .. encode(text)
    elseif CurrentChat == "Global" then
        payload = CFG.TAG .. crypt(text, CFG.KEY, CFG.G_MARK)
        table.insert(Contacts["Global"].messages, {sender = LocalPlayer.Name, text = text, mine = true, role = myRole})
    else
        payload = CFG.TAG .. crypt(CurrentChat .. "|" .. text, CFG.KEY, CFG.P_MARK)
        table.insert(Contacts[CurrentChat].messages, {sender = LocalPlayer.Name, text = text, mine = true, role = myRole})
    end
    
    if endp.ClassName == "RemoteEvent" then endp:FireServer(payload, "All") else endp:SendAsync(payload) end
    updateView()
end

local function onIn(msg, sender)
    if sender == LocalPlayer.Name or not msg:find(CFG.TAG) then return end
    local raw = msg:split(CFG.TAG)[2]
    if not raw then return end
    local smode = raw:sub(1, 1)
    
    if smode == CFG.S_MARK then
        local role = raw:sub(2, 2)
        local syncData = decode(raw:sub(3))
        addContact(sender, role)
        if syncData == "INIT" then send("ACK", "SYNC") end
        return
    end

    local ok, mode, dec, role = pcall(function() return decrypt(raw, CFG.KEY) end)
    if not ok then return end

    if mode == CFG.G_MARK then
        table.insert(Contacts["Global"].messages, {sender = sender, text = dec, mine = false, role = role})
        if CurrentChat == "Global" then updateView() else notifyContact("Global") end
    elseif mode == CFG.P_MARK then
        local target, val = dec:match("([^|]+)|(.+)")
        if target == LocalPlayer.Name then
            if not Contacts[sender] then addContact(sender, role) end
            table.insert(Contacts[sender].messages, {sender = sender, text = val, mine = false, role = role})
            if CurrentChat == sender then updateView() else notifyContact(sender) end
        end
    end
end

if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
    TextChatService.MessageReceived:Connect(function(p) if p.TextSource then onIn(p.Text, p.TextSource.Name) end end)
end
local oldEv = ReplicatedStorage:FindFirstChild("OnMessageDoneFiltering", true)
if oldEv then oldEv.OnClientEvent:Connect(function(d) onIn(d.Message, d.FromSpeaker) end) end

