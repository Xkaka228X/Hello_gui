local lang = "RU"
local index = 0

local function UpdateUI()
    local qCount = #quotes
    if lang == "RU" then
        PrevButton.Text = "ПРЕД. МУДРОСТЬ"
        NextButton.Text = "СЛЕД. МУДРОСТЬ"
        SayButton.Text = "ПРОПОТОЛКОВАТЬ В ЧАТ"
        LangButton.Text = "ЯЗЫК: RU"
        CloseButton.Text = "ВЕРНУТЬ НА ПОЛКУ"
        Description.Text = "113 ступеней мудрости Стэйтема. Издательство 'Эксмо-Пацан' 2026. Запомни, а то забудешь."
        PageCounter.Text = (index == 0) and "Инфо" or "Стр. " .. index
        if index > 0 then QuoteLabel.Text = "« " .. quotes[index].ru .. " »" end
    else
        PrevButton.Text = "PREV WISDOM"
        NextButton.Text = "NEXT WISDOM"
        SayButton.Text = "PREACH IN CHAT"
        LangButton.Text = "LANGUAGE: EN"
        CloseButton.Text = "PUT ON SHELF"
        Description.Text = "113 steps of Statham's wisdom. Definitive Global Edition. Remember it, or you'll forget."
        PageCounter.Text = (index == 0) and "Info" or "Page " .. index
        if index > 0 then QuoteLabel.Text = "“ " .. quotes[index].en .. " ”" end
    end
end

UpdateUI()

OpenButton.MouseButton1Click:Connect(function()
    CoverFrame.Visible = false
    PagesFrame.Visible = true
end)

NextButton.MouseButton1Click:Connect(function()
    index = index + 1
    if index > #quotes then index = 1 end
    Description.Visible = false
    QuoteLabel.Visible = true
    UpdateUI()
end)

PrevButton.MouseButton1Click:Connect(function()
    index = index - 1
    if index < 0 then index = 0 end
    if index == 0 then
        Description.Visible = true
        QuoteLabel.Visible = false
    else
        Description.Visible = false
        QuoteLabel.Visible = true
    end
    UpdateUI()
end)

LangButton.MouseButton1Click:Connect(function()
    lang = (lang == "RU") and "EN" or "RU"
    UpdateUI()
end)

SayButton.MouseButton1Click:Connect(function()
    if index > 0 then
        local q = quotes[index]
        local msg = (lang == "RU") and q.ru or q.en
        if game:GetService("TextChatService").ChatVersion == Enum.ChatVersion.TextChatService then
            game:GetService("TextChatService").TextChannels.RBXGeneral:SendAsync(msg)
        else
            game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(msg, "All")
        end
    end
end)

CloseButton.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)
