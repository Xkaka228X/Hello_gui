local index = 1

local function UpdateQuote()
    QuoteLabel.Text = "« " .. quotes[index] .. " »"
    PageCounter.Text = "Стр. " .. index
end

UpdateQuote()

OpenButton.MouseButton1Click:Connect(function()
    CoverFrame.Visible = false
    PagesFrame.Visible = true
end)

NextButton.MouseButton1Click:Connect(function()
    index = index + 1
    if index > #quotes then index = 1 end
    UpdateQuote()
end)

PrevButton.MouseButton1Click:Connect(function()
    index = index - 1
    if index < 1 then index = #quotes end
    UpdateQuote()
end)

SayButton.MouseButton1Click:Connect(function()
    local msg = quotes[index]
    if game:GetService("TextChatService").ChatVersion == Enum.ChatVersion.TextChatService then
        game:GetService("TextChatService").TextChannels.RBXGeneral:SendAsync(msg)
    else
        game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(msg, "All")
    end
end)

CloseButton.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)

