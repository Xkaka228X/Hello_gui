local function updateLanguage()
    local t = TEXTS[currentLang]
    Title.Text = t.Title
    Desc.Text = t.Desc
    CloseButton.Text = t.Close
    DonateButton.Text = t.Donate
    StatusLabel.Text = t.Copied
end

LangButton.MouseButton1Click:Connect(function()
    currentLang = (currentLang == "RU") and "EN" or "RU"
    updateLanguage()
end)

CloseButton.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

DonateButton.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(PLACE_URL)
    end
    
    ButtonContainer.Visible = false
    StatusLabel.Visible = true
    
    task.wait(2.5)
    ScreenGui:Destroy()
end)
