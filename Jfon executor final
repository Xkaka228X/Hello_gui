local function refreshSaved()
    for _, item in pairs(SavedTab:GetChildren()) do if item:IsA("Frame") then item:Destroy() end end
    local files = listfiles("JfonScripts")
    for _, path in pairs(files) do
        local name = path:gsub("JfonScripts/", ""):gsub("JfonScripts\\", "")
        local item = Instance.new("Frame", SavedTab); item.Size = UDim2.new(0.95, 0, 0, 50); item.BackgroundColor3 = Theme.Button; addCorner(item, 6)
        local label = Instance.new("TextLabel", item); label.Text = name; label.Size = UDim2.new(0.6, 0, 1, 0); label.Position = UDim2.new(0.05, 0, 0, 0); label.TextColor3 = Theme.Text; label.BackgroundTransparency = 1; label.TextXAlignment = "Left"; label.Font = "Gotham"
        local loadBtn = Instance.new("TextButton", item); loadBtn.Text = "LOAD"; loadBtn.Size = UDim2.new(0.15, 0, 0.7, 0); loadBtn.Position = UDim2.new(0.65, 0, 0.15, 0); loadBtn.BackgroundColor3 = Theme.Background; loadBtn.TextColor3 = Color3.new(0, 1, 0); addCorner(loadBtn, 4)
        loadBtn.MouseButton1Click:Connect(function() EditorBox.Text = readfile(path); EditorTab.Visible = true; SavedTab.Visible = false; CloudTab.Visible = false end)
        local delBtn = Instance.new("TextButton", item); delBtn.Text = "DEL"; delBtn.Size = UDim2.new(0.12, 0, 0.7, 0); delBtn.Position = UDim2.new(0.82, 0, 0.15, 0); delBtn.BackgroundColor3 = Theme.Background; delBtn.TextColor3 = Color3.new(1, 0, 0); addCorner(delBtn, 4)
        delBtn.MouseButton1Click:Connect(function() delfile(path); item:Destroy() end)
    end
end

-------------------------------------------------------------------------
-- УМНЫЙ ЗАПУСК
-------------------------------------------------------------------------
local function ExecuteScript(input)
    if input == "" then return end
    local cleanInput = input:gsub("^%s*(.-)%s*$", "%1")
    local success, err = pcall(function()
        if cleanInput:match("^https?://") then loadstring(game:HttpGet(cleanInput))()
        else loadstring(cleanInput)() end
    end)
    if not success then warn("Jfon Error: "..tostring(err)) end
end

