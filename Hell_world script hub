local selectedUrl = ""
local function AddButton(name, url, parent, special)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(0.95, 0, 0, 40)
    btn.BackgroundColor3 = special and Color3.fromRGB(0, 60, 120) or Color3.fromRGB(40, 40, 45)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamMedium
    btn.ZIndex = 700
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", btn)
    s.Color = Color3.fromRGB(0, 170, 255) s.Transparency = 0.6
    
    btn.MouseButton1Click:Connect(function()
        PlayClick()
        selectedUrl = url
        ConfirmFrame.Visible = true
    end)
end

-- ЛОГИКА
local function SwitchTab(tab)
    PlayClick()
    GamesScroll.Visible = (tab == "Games")
    ScriptsScroll.Visible = (tab == "Scripts")
    GamesTabBtn.BackgroundColor3 = (tab == "Games") and Color3.fromRGB(0, 100, 200) or Color3.fromRGB(35, 35, 40)
    ScriptsTabBtn.BackgroundColor3 = (tab == "Scripts") and Color3.fromRGB(0, 100, 200) or Color3.fromRGB(35, 35, 40)
end

GamesTabBtn.MouseButton1Click:Connect(function() SwitchTab("Games") end)
ScriptsTabBtn.MouseButton1Click:Connect(function() SwitchTab("Scripts") end)
Yes.MouseButton1Click:Connect(function() PlayClick(); ConfirmFrame.Visible = false; loadstring(game:HttpGet(selectedUrl))() end)
No.MouseButton1Click:Connect(function() PlayClick(); ConfirmFrame.Visible = false end)
ToggleButton.MouseButton1Click:Connect(function() PlayClick(); MainFrame.Visible = not MainFrame.Visible end)
CloseButton.MouseButton1Click:Connect(function() PlayClick(); ScreenGui:Destroy() end)

