local function AddButton(name, data, parent, special)
    local btnFrame = Instance.new("Frame", parent)
    btnFrame.Size = UDim2.new(0.95, 0, 0, 40)
    btnFrame.BackgroundColor3 = special and Color3.fromRGB(0, 60, 120) or Color3.fromRGB(40, 40, 45)
    btnFrame.ZIndex = 700
    Instance.new("UICorner", btnFrame)

    local mainBtn = Instance.new("TextButton", btnFrame)
    mainBtn.Size = (parent == CustomScroll) and UDim2.new(0.7, 0, 1, 0) or UDim2.new(1, 0, 1, 0)
    mainBtn.BackgroundTransparency = 1; mainBtn.Text = name; mainBtn.TextColor3 = Color3.fromRGB(255, 255, 255); mainBtn.ZIndex = 705

    mainBtn.MouseButton1Click:Connect(function()
        PlayClick(); selectedData = data; CFTitle.Text = "Запустить '"..name.."'?"; ConfirmFrame.Visible = true
    end)

    if parent == CustomScroll then
        local editBtn = Instance.new("TextButton", btnFrame)
        editBtn.Size = UDim2.new(0.12, 0, 0.8, 0); editBtn.Position = UDim2.new(0.72, 0, 0.1, 0)
        editBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 200); editBtn.Text = "✏️"; editBtn.ZIndex = 705
        Instance.new("UICorner", editBtn)

        local delBtn = Instance.new("TextButton", btnFrame)
        delBtn.Size = UDim2.new(0.12, 0, 0.8, 0); delBtn.Position = UDim2.new(0.86, 0, 0.1, 0)
        delBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50); delBtn.Text = "🗑️"; delBtn.ZIndex = 705
        Instance.new("UICorner", delBtn)

        delBtn.MouseButton1Click:Connect(function()
            PlayClick()
            for i, v in pairs(CustomData) do if v.Name == name then table.remove(CustomData, i) break end end
            SaveCustomScripts(CustomData); btnFrame:Destroy()
        end)

        editBtn.MouseButton1Click:Connect(function()
            PlayClick()
            CustomNameInput.Text = name
            CustomUrlInput.Text = data
            AddMenuFrame.Visible = true
            for i, v in pairs(CustomData) do if v.Name == name then table.remove(CustomData, i) break end end
            SaveCustomScripts(CustomData); btnFrame:Destroy()
        end)
    end
end

