-- Логика сохранения
local function SaveCustomScripts(scriptsTable)
    if writefile then pcall(function() writefile(SaveFileName, HttpService:JSONEncode(scriptsTable)) end) end
end
local function LoadCustomScripts()
    if isfile and isfile(SaveFileName) then
        local s, r = pcall(function() return HttpService:JSONDecode(readfile(SaveFileName)) end)
        return s and r or {}
    end
    return {}
end
